{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:steering && npm run test:world && npm run test:scenery && npm run test:glsl",
    "test:steering": "node --experimental-strip-types tests/steering.test.ts",
    "test:world": "esbuild tests/world.test.ts --bundle --format=esm --platform=node --outfile=.tmp/world.test.mjs --log-level=warning && node .tmp/world.test.mjs",
    "test:glsl": "esbuild tests/glsl.test.ts --bundle --format=esm --platform=node --outfile=.tmp/glsl.test.mjs --log-level=warning --external:@shaderfrog/glsl-parser && node .tmp/glsl.test.mjs",
    "test:scenery": "esbuild tests/scenery.test.ts --bundle --format=esm --platform=node --outfile=.tmp/scenery.test.mjs --log-level=warning && node .tmp/scenery.test.mjs"
  },
  "dependencies": {
    "@types/three": "^0.186.0",
    "clsx": "2.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@shaderfrog/glsl-parser": "^5.3.1",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0"
  }
}
